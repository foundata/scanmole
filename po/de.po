#: src/scanmole/gui/app.py:1138
msgid "Reset Settings?"
msgstr "Einstellungen zurücksetzen?"

#: src/scanmole/gui/app.py:1140
msgid ""
"All GUI options return to their defaults. Scanned files and folders on disk "
"are not touched."
msgstr ""
"Alle GUI-Optionen werden auf ihre Standardwerte zurückgesetzt. Gescannte "
"Dateien und Ordner auf der Festplatte bleiben unberührt."

#: src/scanmole/gui/app.py:1145
msgid "Reset"
msgstr "Zurücksetzen"

#: src/scanmole/gui/app.py:1163
msgid "Settings reset to defaults."
msgstr "Einstellungen auf Standardwerte zurückgesetzt."

#: src/scanmole/gui/app.py:1190
msgid "Easy document scanning for Linux"
msgstr "Einfaches Scannen von Dokumenten unter Linux"

#: src/scanmole/gui/app.py:1198
msgid "unknown"
msgstr "unbekannt"

#: src/scanmole/gui/app.py:1200
msgid "License"
msgstr "Lizenz"

#: src/scanmole/gui/app.py:1213
msgid ""
"ScanMole scans documents through SANE, detects blank pages, assembles PDFs, "
"and optionally makes them text-searchable with OCR."
msgstr ""
"ScanMole scannt Dokumente über SANE, erkennt leere Seiten, erstellt PDFs und "
"macht sie auf Wunsch per Texterkennung (OCR) durchsuchbar."

