msgid "scanmole CLI not found — install it or add it to PATH."
msgstr ""
"scanmole wurde nicht gefunden – bitte installieren oder zu PATH hinzufügen."

#: src/scanmole/gui/app.py:414
msgid "Device search timed out."
msgstr "Zeitüberschreitung bei der Gerätesuche."

