#: src/scanmole/gui/app.py:448
msgid "No scanners found — connect one and press Refresh."
msgstr "Keine Scanner gefunden – bitte anschließen und erneut suchen."

#: src/scanmole/gui/app.py:450
msgid "No scanners found."
msgstr "Keine Scanner gefunden."

