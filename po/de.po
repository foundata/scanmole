msgstr "PDF durchsuchbar machen"

#: src/scanmole/gui/app.py:243
msgid "OCR Language"
msgstr "OCR-Sprache"

#: src/scanmole/gui/app.py:246
msgid "Tesseract language codes — combine with \"+\", e.g. \"deu+eng\""
msgstr "Tesseract-Sprachcodes – mit »+« kombinierbar, z. B. »deu+eng«"

#: src/scanmole/gui/app.py:250
msgid "Skip Blank Pages"
msgstr "Leere Seiten überspringen"

#: src/scanmole/gui/app.py:251
msgid "Remove pages detected as empty"
msgstr "Als leer erkannte Seiten entfernen"

#: src/scanmole/gui/app.py:257
