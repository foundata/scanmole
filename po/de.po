#: src/scanmole/gui/app.py:87
msgid "No Pages Scanned"
msgstr "Keine Seiten gescannt"

#: src/scanmole/gui/app.py:89
msgid ""
"No pages were scanned — is the ADF (Automatic Document Feeder) loaded?\n"
"(All pages may also have been detected as blank.)"
msgstr ""
"Es wurden keine Seiten gescannt – ist Papier im Einzug (ADF)?\n"
"(Möglicherweise wurden auch alle Seiten als leer erkannt.)"

#: src/scanmole/gui/app.py:95
msgid "Scanner Error"
msgstr "Scannerfehler"

#: src/scanmole/gui/app.py:97
msgid ""
"The scanner reported an error.\n"
"\n"
"Make sure it is connected, powered on and not in use by another application, "
"then try again."
msgstr ""
"Der Scanner hat einen Fehler gemeldet.\n"
"\n"
"Stellen Sie sicher, dass er angeschlossen und eingeschaltet ist und nicht "
"von einer anderen Anwendung verwendet wird, und versuchen Sie es dann erneut."

#: src/scanmole/gui/app.py:104
msgid "Missing Dependency"
msgstr "Fehlende Abhängigkeit"

#: src/scanmole/gui/app.py:106
msgid ""
"scanmole is missing a required tool (e.g. scanimage, img2pdf, ocrmypdf) on "
"this system. See the log for details."
msgstr ""
"scanmole fehlt ein benötigtes Programm (z. B. scanimage, img2pdf, ocrmypdf) "
"auf diesem System. Details siehe Protokoll."

#: src/scanmole/gui/app.py:111
msgid "Processing Failed"
msgstr "Verarbeitung fehlgeschlagen"

#: src/scanmole/gui/app.py:113
msgid ""
"PDF assembly or OCR failed after scanning. The scanned pages were kept; see "
"the log for the folder path."
msgstr ""
"Die PDF-Erstellung oder die Texterkennung (OCR) ist nach dem Scannen "
"fehlgeschlagen. Die gescannten Seiten wurden aufbewahrt; der Ordnerpfad "
"steht im Protokoll."

