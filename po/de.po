msgstr "Ausgabeordner wählen"

#: src/scanmole/gui/app.py:269
msgid "Filename (optional)"
msgstr "Dateiname (optional)"

#: src/scanmole/gui/app.py:271
msgid "Leave empty for an automatic name; \".pdf\" is appended if missing"
msgstr ""
"Leer lassen für einen automatischen Namen; ».pdf« wird bei Bedarf angehängt"

#: src/scanmole/gui/app.py:283
msgid "Saved"
msgstr "Gespeichert"

#: src/scanmole/gui/app.py:285
msgid "Show in Folder"
msgstr "Im Ordner anzeigen"

