msgid_plural "Scan finished — keeping %(kept)d of %(total)d pages…"
msgstr[0] "Scan abgeschlossen – %(kept)d von %(total)d Seite wird übernommen…"
msgstr[1] ""
"Scan abgeschlossen – %(kept)d von %(total)d Seiten werden übernommen…"

