"Placeholders: {YYYY}, {MM}, {DD} (date), {hh}, {mm}, {ss} (time), {NN}/{NNN} "
"(auto-number), {preset}, {device}"
msgstr ""
"Platzhalter: {YYYY}, {MM}, {DD} (Datum), {hh}, {mm}, {ss} (Uhrzeit), "
"{NN}/{NNN} (automatische Nummerierung), {preset}, {device}"

